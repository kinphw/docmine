{
  // F5 디버그 구성. 사이드바 'Run and Debug' 패널 드롭다운에서 선택.
  // breakpoint 는 디버거 attach 후 자동 hit.
  //
  // 'DocMine.UI' — 메인 GUI 모드 (args 없음).
  // 'HwpWorker (stdin 수동)' — 같은 python.exe 를 --hwp-worker 모드로 실행,
  //                           integratedTerminal 에 직접 JSON 한 줄 타이핑해
  //                           응답 확인. STDIO 프로토콜 단독 검증용.
  //                           종료: `{"op":"quit"}` 또는 Ctrl+Z, Enter.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DocMine.UI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "fdd 빌드",
      "program": "${workspaceFolder}/src/DocMine.UI/bin/Release/net8.0-windows/win-x64/publish/docmine.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "HwpWorker (stdin 수동)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "fdd 빌드",
      "program": "${workspaceFolder}/src/DocMine.UI/bin/Release/net8.0-windows/win-x64/publish/docmine.exe",
      "args": ["--hwp-worker"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "HwpWorker (--keep-hwp)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "fdd 빌드",
      "program": "${workspaceFolder}/src/DocMine.UI/bin/Release/net8.0-windows/win-x64/publish/docmine.exe",
      "args": ["--hwp-worker", "--keep-hwp"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
