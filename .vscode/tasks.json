{
  // VSCode 빌드/배포 태스크.
  // Ctrl+Shift+B 로 기본(fdd 빌드) 실행. Ctrl+Shift+P → "Tasks: Run Task" 로 그 외.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "fdd 빌드",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/DocMine.UI/DocMine.UI.csproj",
        "-c", "Release",
        "-p:SelfContained=false"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true },
      "detail": ".NET 8 런타임 가정. 단일 exe 산출 (zip 없음)"
    },
    {
      "label": "fdd 빌드 + zip",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/make_release_cs.ps1"
      ],
      "problemMatcher": [],
      "detail": "publish + zip 패키징 → release/docmine_v{ver}.zip"
    }
  ]
}
