{
  // VSCode 빌드/실행/배포 태스크.
  // Ctrl+Shift+B 로 기본(build) 실행. Ctrl+Shift+P → "Tasks: Run Task" 로 그 외.
  // launch.json 의 preLaunchTask 에서도 참조됨.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/DocMine.sln", "-v", "minimal"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true },
      "detail": "전체 솔루션 Debug 빌드 (HwpWorker.exe 자동 복사)"
    },
    {
      "label": "build:UI",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/DocMine.UI/DocMine.UI.csproj", "-v", "minimal"],
      "problemMatcher": "$msCompile",
      "detail": "UI 단독 빌드 (의존 자동 포함)"
    },
    {
      "label": "build:HwpWorker",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/DocMine.HwpWorker/DocMine.HwpWorker.csproj", "-v", "minimal"],
      "problemMatcher": "$msCompile",
      "detail": "HwpWorker 단독 빌드 (COM/STDIO 디버그용)"
    },
    {
      "label": "build:Core",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/DocMine.Core/DocMine.Core.csproj", "-v", "minimal"],
      "problemMatcher": "$msCompile",
      "detail": "Core 만 빌드 (DB/스캐너/Hwp 파서 단위 작업용)"
    },
    {
      "label": "clean",
      "type": "process",
      "command": "dotnet",
      "args": ["clean", "${workspaceFolder}/DocMine.sln", "-v", "minimal"],
      "problemMatcher": "$msCompile",
      "detail": "bin/obj 비우기 (캐시 꼬임 시)"
    },
    {
      "label": "publish:fdd",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/DocMine.UI/DocMine.UI.csproj",
        "-c", "Release",
        "-p:SelfContained=false"
      ],
      "problemMatcher": "$msCompile",
      "detail": ".NET 8 런타임 가정. AfterPublish target 이 HwpWorker.exe 동봉"
    },
    {
      "label": "release:zip",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/make_release_cs.ps1"
      ],
      "problemMatcher": [],
      "detail": "publish + zip 패키징 → release/docmine-cs_v{ver}.zip"
    },
    {
      "label": "release:zip (재패키징)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/make_release_cs.ps1",
        "-SkipBuild"
      ],
      "problemMatcher": [],
      "detail": "기존 publish 결과만 zip — publish 안 다시 함"
    }
  ]
}
