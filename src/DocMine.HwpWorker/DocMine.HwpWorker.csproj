<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DocMine.HwpWorker — 한/글 COM 워커 (별도 .exe).

    Python 의 multiprocessing.Process(worker_main) 등가물. .NET 은 process
    fork 가 없어 mp.Queue 패턴을 직접 옮길 수 없으므로, STDIO JSON-line
    프로토콜로 통신하는 독립 console exe 를 별도 빌드.

    크래시 격리:
      한/글 COM 이 워커 안에서 죽어도 메인 GUI 는 살아남아야 함. 메인이
      Process.Exited 를 감지해 새 워커를 spawn — Python 의 'COM_RESTART'
      카운터 + 타임아웃 재시작 패턴 1:1 재현.

    Job Object:
      메인 프로세스가 KILL_ON_JOB_CLOSE Job 에 자가 할당해 두면, Process.Start
      로 띄운 자식 워커는 동일 Job 을 자동 상속 → 메인이 어떻게 죽든 워커
      커널 차원에서 회수. 한/글 본체(Hwp.exe) 는 ShellExecute 경로에 따라
      Job 을 벗어날 수 있어 taskkill 보조 안전망 유지.

    Interop:
      dynamic late-bind (Activator.CreateInstance + Type.GetTypeFromProgID).
      docmine 은 GetTextFile/Open/Close 정도만 호출 — sub-COM (HParameterSet
      등) 미사용이라 PIA 불필요. PIA 없으면 NuGet 의존도 줄고 배포 단순.

    OutputType=Exe + 콘솔 모드: 메인 GUI 가 stdin/stdout 으로 통신.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>DocMine.HwpWorker</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 배포 시 단일 exe 로 — UI 의 AfterPublish 가 이 산출물을 가져옴.
         SelfContained=false 명시 — RuntimeIdentifier 있어도 FDD 유지 (UI 와 일치). -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocMine.Core\DocMine.Core.csproj" />
    <ProjectReference Include="..\DocMine.Win32\DocMine.Win32.csproj" />
  </ItemGroup>

</Project>
