<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DocMine.Core — 도메인 라이브러리. GUI 무의존.

    포함:
      Config/      UserSettings (%APPDATA%\DocMine\settings.json) + AppConfig 빌더
                   + LegacyEnvImporter (.env → settings.json 1회 마이그레이션)
      Scanning/    드라이브 재귀 스캐너 + CSV writer
      Hwp/         HWPX ZIP 직접 파싱 + COM 래퍼 (Forge HwpSession 차용)  [Phase 4]
      Pdf/         PdfPig 기반 텍스트 추출
      Db/          MySqlConnector 기반 Repository + 검색 서비스
      Pipeline/    스캔/HWP 적재/PDF 적재 runner

    의존:
      MySqlConnector — pymysql 대체 (async, MariaDB 호환, MIT)
      PdfPig         — PyMuPDF 대체 (순수 매니지드, Apache 2.0)
  -->

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <!-- iText 9 (구 iText 7 계보) — Java 본진 20년+ 검증 + .NET port.
         한국 금융권 자바 시스템 표준에 가까워 한컴 export / 손상 PDF 강건.
         AGPL — 개인 사용 전제로 채택 (배포 시 라이선스 의무 발생).
         MuPDFCore 29MB → iText 매니지드로 용량 축소 + silent crash 안정성 동시 시도. -->
    <PackageReference Include="itext" Version="9.6.0" />
  </ItemGroup>

</Project>
