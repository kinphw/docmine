<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DocMine.UI — 단일 진입점 (Python pythonw.exe + mp.Process 패턴 1:1).

    ★ AssemblyName=docmine — 개발 산출물은 docmine.exe (식별 편의).
      단, 운영환경 DRM 솔루션(Fasoo·MarkAny 등) 은 프로세스 basename 으로
      파일 I/O 허용을 판정하므로 *배포 zip* 은 python.exe 로 rename 한다
      (make_release_cs.ps1). PDF 등 보호 파일 접근이 'python.exe' 여야 허용됨.
      → 개발: docmine.exe / 배포: python.exe (같은 바이너리, 이름만 다름).
      워커 spawn 은 Environment.ProcessPath(자기 자신)라 파일명과 무관하게 동작.

    단일 binary 다중 인스턴스:
      ㆍ args 없음 / GUI args ⇒ MainForm (WinForms)
      ㆍ args == "[hyphen][hyphen]hwp-worker" ⇒ HwpWorkerEntry.Run (콘솔 STDIO 루프)
      Python 의 mp.Process(worker_main) 가 같은 인터프리터 바이너리를
      spawn 하는 패턴과 동일. 산출 파일 한 개(개발 docmine.exe / 배포
      python.exe)로 모든 역할.

    publish 옵션:
      FDD (.NET 8 런타임 가정, 가장 가벼움):
        dotnet publish -c Release -p:SelfContained=false
      자체포함 (런타임 없는 PC 용):
        dotnet publish -c Release -p:SelfContained=true -p:EnableCompressionInSingleFile=true

    PublishTrimmed 는 사용 불가 (WinForms + dynamic COM 비호환).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>docmine</AssemblyName>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Explorer/바로가기에 표시되는 exe 리소스 아이콘. 폼 윈도우 아이콘은 AppIcon.Build()
         가 코드로 별도 생성. 디자인이 일치하도록 두 곳을 같이 업데이트할 것. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocMine.Core\DocMine.Core.csproj" />
    <ProjectReference Include="..\DocMine.Win32\DocMine.Win32.csproj" />
  </ItemGroup>

  <!-- 개발 편의: publish(=fdd 빌드) 후 docmine.exe 를 솔루션 루트에 복사.
       깊은 publish 경로로 찾아 들어갈 필요 없이 루트에서 바로 실행.
       배포용 버전 zip(python.exe rename) 은 make_release_cs.ps1 이 별도 담당. -->
  <Target Name="CopyExeToRoot" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)docmine.exe"
          DestinationFolder="$(MSBuildProjectDirectory)\..\.."
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="  → 루트에 docmine.exe 복사 완료 (실행용)" />
  </Target>

</Project>
