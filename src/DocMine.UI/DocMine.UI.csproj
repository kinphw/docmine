<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DocMine.UI — 단일 진입점 (Python pythonw.exe + mp.Process 패턴 1:1).

    ★ AssemblyName=python — DRM 화이트리스트 우회 필수.
      운영환경 DRM 솔루션(Fasoo·MarkAny 등) 이 프로세스 basename 으로
      파일 I/O 허용 여부를 판정하므로, 발행 산출물 이름이 정확히
      'python.exe' 여야 PDF 등 파일 접근이 허용됨.

    단일 binary 다중 인스턴스:
      ㆍ args 없음 / GUI args ⇒ MainForm (WinForms)
      ㆍ args == "[hyphen][hyphen]hwp-worker" ⇒ HwpWorkerEntry.Run (콘솔 STDIO 루프)
      Python 의 mp.Process(worker_main) 가 같은 인터프리터 바이너리를
      spawn 하는 패턴과 동일. 산출 파일은 python.exe 한 개로 모든 역할.

    publish 옵션:
      FDD (.NET 8 런타임 가정, 가장 가벼움):
        dotnet publish -c Release -p:SelfContained=false
      자체포함 (런타임 없는 PC 용):
        dotnet publish -c Release -p:SelfContained=true -p:EnableCompressionInSingleFile=true

    PublishTrimmed 는 사용 불가 (WinForms + dynamic COM 비호환).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>python</AssemblyName>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocMine.Core\DocMine.Core.csproj" />
    <ProjectReference Include="..\DocMine.Win32\DocMine.Win32.csproj" />
  </ItemGroup>

</Project>
